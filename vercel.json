{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://anicrunch-backend.onrender.com/api/$1"
    },
    {
      "src": "/anime/.*",
      "dest": "/anime.html"
    },
    {
      "src": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml"
      }
    },
    {
      "handle": "filesystem"
    }
  ]
}
